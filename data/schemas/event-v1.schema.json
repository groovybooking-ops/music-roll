{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicroll.local/schemas/event-v1.schema.json",
  "title": "Music Roll Event v1",
  "type": "object",
  "required": ["musicRollEventId", "schemaVersion", "musicRollArtistIds", "venue", "location", "startsAt", "provider", "externalEventId", "retrievedAt", "sourceProvenance"],
  "properties": {
    "musicRollEventId": { "type": "string", "pattern": "^mr_event_[0-9]{6}$" },
    "schemaVersion": { "const": 1 },
    "musicRollArtistIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^mr_artist_[0-9]{6}$" } },
    "provider": { "type": "string", "minLength": 1 },
    "externalEventId": { "type": "string", "minLength": 1 },
    "ticketUrl": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
